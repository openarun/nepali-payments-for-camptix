# Normalize text to LF so Windows checkouts do not reintroduce CRLF noise.
* text=auto eol=lf

*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
